{
  "name": "neurons-cli",
  "version": "0.3.0",
  "description": "Neurons: live 3D view of what Claude Code reads, edits, creates and deletes in a repository, driven by Claude Code HTTP hooks.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "neu": "./dist/cli.mjs",
    "neurons": "./dist/cli.mjs"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "npm run build:web && npm run build:cli && npm run build:docs",
    "build:web": "vite build --config web/vite.config.ts",
    "build:cli": "tsdown",
    "build:docs": "node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run && vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "force-graph": "^1.52.0",
    "three": "^0.186.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upex-galaxy/neurons.git"
  },
  "homepage": "https://github.com/upex-galaxy/neurons#readme",
  "bugs": {
    "url": "https://github.com/upex-galaxy/neurons/issues"
  }
}
